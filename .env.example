# Predict API
PREDICT_URL=                        # Server-side predict API base URL
NEXT_PUBLIC_PREDICT_URL=/predict-api # Client-side predict API prefix (rewritten by Next.js)
NEXT_PUBLIC_PREDICT_WS_URL=wss://api.liberfi.io/prediction/api/v1/ws # Predict WebSocket URL (optional, enables real-time orderbook)
NEXT_PUBLIC_CENTRIFUGO_WS_URL=wss://api.liberfi.io/ws/v1 # Centrifugo client WS for World Cup live updates; staging uses wss://api.liberfi.io/staging/ws/v1

# Privy Authentication
NEXT_PUBLIC_PRIVY_APPID=            # Privy frontend App ID
PRIVY_APP_ID=                       # Privy server App ID
PRIVY_APP_SECRET=                   # Privy server Secret

# JWT
JWT_SECRET=                         # JWT signing secret
JWT_ISSUER=                         # JWT issuer claim
JWT_AUDIENCE=                       # JWT audience claim
JWT_EXPIRES_IN=24h                  # JWT expiration
JWT_COOKIE_NAME=predict-token       # JWT cookie name

# Telegram Mini App
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://t.me/liberfi_live_bot/liberfi_prediction_app # Telegram Mini App base URL for referral share links
TELEGRAM_BOT_TOKEN=                 # Server-side Telegram bot token for initData verification
TG_MINIAPP_COOKIE_NAME=tg_miniapp_context # Telegram Mini App context cookie name
TG_MINIAPP_COOKIE_MAX_AGE=86400     # Telegram Mini App context cookie max age in seconds
TG_MINIAPP_INITDATA_MAX_AGE=86400   # Telegram initData max accepted age in seconds
# TG_MINIAPP_COOKIE_SECRET=         # Optional dedicated signing secret; falls back to JWT_SECRET

# Feature flags
# Enable the Kalshi venue. Unset / empty / false → Kalshi is disabled: the
# Kalshi wallet block and aggregate balance summary are hidden in the header,
# and the markets list is pinned to Polymarket only (platform filter hidden).
# NEXT_PUBLIC_ENABLE_KALSHI=true

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=      # Google Analytics Measurement ID

# Local SDK link (development only)
# Point @liberfi.io/* imports + CSS at the sibling react-sdk source tree for
# live HMR instead of the published npm dist. Both must be set; takes effect
# only when NODE_ENV !== production. See AGENTS.md "本地 App 与 SDK 联调步骤".
# USE_LOCAL_SDK=true                # Opt-in switch for local SDK link mode
# LOCAL_SDK_ROOT=../react-sdk       # Path to react-sdk root, relative to repo root
